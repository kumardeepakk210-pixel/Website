{
  "rewrites": [
    {
      "source": "/api/creator/:path*",
      "destination": "/api/creator.js"
    },
    {
      "source": "/api/influencers/:path*",
      "destination": "/api/influencers.js"
    },
    {
      "source": "/api/orders/:path*",
      "destination": "/api/orders.js"
    },
    {
      "source": "/api/public/:path*",
      "destination": "/api/public.js"
    },
    {
      "source": "/api/wallet/:path*",
      "destination": "/api/wallet.js"
    },
    {
      "source": "/inventory",
      "destination": "/index.html"
    },
    {
      "source": "/inventory/",
      "destination": "/index.html"
    },
    {
      "source": "/auth/callback",
      "destination": "/index.html"
    },
    {
      "source": "/auth/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/account",
      "destination": "/index.html"
    },
    {
      "source": "/profile",
      "destination": "/index.html"
    },
    {
      "source": "/product/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/collections",
      "destination": "/index.html"
    },
    {
      "source": "/collections/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/new-arrivals",
      "destination": "/index.html"
    },
    {
      "source": "/best-sellers",
      "destination": "/index.html"
    },
    {
      "source": "/cart",
      "destination": "/index.html"
    },
    {
      "source": "/wishlist",
      "destination": "/index.html"
    },
    {
      "source": "/shop",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/occasion",
      "destination": "/index.html"
    },
    {
      "source": "/occasion/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin-rewards.html"
    },
    {
      "source": "/admin-rewards",
      "destination": "/admin-rewards.html"
    },
    {
      "source": "/creator",
      "destination": "/creator.html"
    },
    {
      "source": "/creator/login",
      "destination": "/creator.html"
    },
    {
      "source": "/creator/dashboard",
      "destination": "/creator.html"
    },
    {
      "source": "/creator/links",
      "destination": "/creator.html"
    },
    {
      "source": "/creator/wallet",
      "destination": "/creator.html"
    },
    {
      "source": "/creator/withdraw",
      "destination": "/creator.html"
    },
    {
      "source": "/creator/points",
      "destination": "/creator.html"
    },
    {
      "source": "/creator/rewards",
      "destination": "/creator.html"
    },
    {
      "source": "/creator/profile",
      "destination": "/creator.html"
    },
    {
      "source": "/influencer/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/creator/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/creator/:slug/product/:code*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
